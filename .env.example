# LibreWXR Configuration
#
# Copy this file to .env and adjust values as needed.  Every setting has
# a sensible default — you only need to set what you want to change.
#
# This file covers the settings most self-hosters will touch.  Advanced
# tuning (per-source publish delays, dBZ calibration offsets, source
# base URLs / S3 buckets, internal memory thresholds) is available via
# LIBREWXR_<SOURCE>_PUBLISH_DELAY_MINUTES, *_DBZ_OFFSET, *_BASE_URL,
# *_S3_BUCKET, etc.  See docs/configuration-reference.md or
# src/librewxr/config.py for the full list and defaults.
#
# ════════════════════════════════════════════════════════════════════════
#   Contents
# ════════════════════════════════════════════════════════════════════════
#
#   0.  Deployment Mode  (← pick single or multi here)
#   1.  Server & Networking
#   2.  Radar Data Sources
#   3.  Regional NWP Models
#   4.  ECMWF IFS + NOAA RRQPE (Global Base Layer)
#   5.  Precipitation Nowcasting
#   6.  Satellite Imagery
#   7.  Weather Alerts (WMO CAP)
#   8.  Tile Rendering
#   9.  Mode Tuning Overrides  (optional per-mode knobs)
#  10.  Persistent Disk Cache
#  11.  Diagnostics & Reliability
#
# ════════════════════════════════════════════════════════════════════════


# ════════════════════════════════════════════════════════════════════════
#   0. DEPLOYMENT MODE
# ════════════════════════════════════════════════════════════════════════
# LibreWXR ships two deployment shapes.  Pick one — the app and the
# docker compose file both read COMPOSE_PROFILES to pick sensible
# defaults for worker counts, cache sizes, thread pools, and memory
# limits.  Any individual knob in section 9 can still be overridden.
#
#   single  - Fetcher + renderer in one container.  Personal /
#             small-scale self-hosting (1 worker, ~3-10 GB RAM
#             depending on enabled regions and NWP sources).
#   multi   - Pipeline sidecar writes a shared snapshot; N renderer
#             workers serve tiles from it.  Production deployment
#             that bypasses the Python GIL on the render path so
#             multi-core racks can actually use every core.
#
# Deploy either mode with the same command:
#   docker compose up --build -d
COMPOSE_PROFILES=single
# (You can also set LIBREWXR_MODE=single/multi if you're not using
# docker compose; LIBREWXR_MODE takes precedence over COMPOSE_PROFILES.)


# ════════════════════════════════════════════════════════════════════════
#   1. SERVER & NETWORKING
# ════════════════════════════════════════════════════════════════════════
# Where the server listens, what URL clients use to reach it, and how
# high they can zoom.

# Public-facing URL used in the weather-maps.json metadata response.
# Set this to whatever URL clients will use to reach your instance.
LIBREWXR_PUBLIC_URL=http://localhost:8080

# Network interface the server binds to.  Default (unset) lets uvicorn
# pick a dual-stack listen — both IPv4 and IPv6 on capable systems.
# This replaced the previous IPv4-only 0.0.0.0 default (commit f1eea96,
# "Default host to None (dual-stack) instead of 0.0.0.0 (IPv4-only)").
# Most self-hosters want the new behaviour, but if your reverse proxy
# or network only speaks IPv4, set this explicitly:
#   0.0.0.0     IPv4 wildcard (all interfaces).  Backwards-compatible
#               with pre-f1eea96 behaviour — what most IPv4-only
#               deployments behind nginx / cloudflared will want.
#   127.0.0.1   IPv4 loopback only — useful when a sidecar proxy on the
#               same host is the only client that should reach LibreWXR.
#   ::          IPv6 wildcard (implies dual-stack on most kernels).
#   <other IP>  Bind to one specific interface.
#LIBREWXR_HOST=0.0.0.0

# Port the server listens on.
LIBREWXR_PORT=8080

# Root log level: DEBUG / INFO / WARNING / ERROR / CRITICAL
# (case-insensitive).  Default INFO: boot status, fetch-cycle timing, and
# per-source fetch durations show; per-cycle noise (ingest summaries,
# memmap-directory lines, fetch-cycle-start banners) logs at DEBUG.
#LIBREWXR_LOG_LEVEL=INFO

# Rotating log file capturing WARNING and above (rotated 5 MB x 3).
# Enabled by default at logs/librewxr.log (relative to the process
# working directory - project root locally, /app in Docker).  The stock
# compose file sets LIBREWXR_LOG_FILE=/logs/librewxr.log and bind-mounts
# ./logs:/logs so it lands in ./logs in the clone directory.  Setting
# the value empty disables the file.
#LIBREWXR_LOG_FILE=logs/librewxr.log

# Maximum tile zoom level (0-12).  Higher values allow more detail when
# zoomed in but use more memory for cached tiles.  12 is the max
# supported by the data sources.
LIBREWXR_MAX_ZOOM=12

# Optional direct TLS termination.  Leave both unset to serve plain HTTP
# and terminate TLS at a reverse proxy (nginx) or tunnel (cloudflared) in
# front of LibreWXR.  To have the server serve HTTPS itself, uncomment
# both lines and point them at your certificate and private key (absolute
# paths).  Both must be set; setting only one has no effect.
# In Docker, also volume-mount the cert files into the container.
#LIBREWXR_SSL_CERTFILE=/path/to/fullchain.pem
#LIBREWXR_SSL_KEYFILE=/path/to/privatekey.pem


# ════════════════════════════════════════════════════════════════════════
#   2. RADAR DATA SOURCES
# ════════════════════════════════════════════════════════════════════════
# Which radar composites to fetch and how often.  Each enabled region
# pulls a separate composite; turning regions off reduces RAM, network,
# and processing.

# Radar regions to fetch.  Use a group alias or comma-separated region
# codes.
#
# Group aliases:
#   CONUS            - Continental US only (default, lightest)
#   US               - All US regions (CONUS + Alaska, Hawaii, Puerto Rico, Guam)
#   CANADA           - Canada (ECCC MSC GeoMet WMS)
#   CENTRAL_AMERICA  - El Salvador + W. Honduras + S. Guatemala + offshore
#                      Pacific (MARN/SNET San Andrés, 120 km range)
#   EUROPE           - Europe — OPERA pan-European composite (~155 radars,
#                      27 countries) + DPC Italian national composite
#                      (ITCOMP wins over OPERA where it covers, since
#                      Italy is not in the OPERA station list)
#   SOUTHEAST_ASIA   - Peninsular Malaysia + N. Sumatra + all of Borneo
#                      + Brunei (MET Malaysia peninsular + east
#                      composites, ~2 km / 10 min)
#   TAIWAN           - Taiwan + W. Pacific buffer (CWA QPESUMS 7-radar
#                      composite, 1.4 km observed dBZ)
#   ALL              - Every available region
#
# Individual regions (can mix with groups):
#   USCOMP  - Continental US        (~63 MB/frame)
#   AKCOMP  - Alaska                (~6 MB/frame)
#   HICOMP  - Hawaii                (~3.4 MB/frame)
#   PRCOMP  - Puerto Rico           (~1 MB/frame)
#   GUCOMP  - Guam                  (~1 MB/frame)
#   CACOMP  - Canada                (~6 MB/frame)
#   SVCOMP  - El Salvador region    (<1 MB/frame)
#   OPERA   - Europe (27 countries) (~16 MB/frame)
#   ITCOMP  - Italy (DPC national radar) (~7 MB/frame)
#   TWCOMP  - Taiwan + W. Pacific   (~3 MB/frame)
#   MYPENINSULAR - Peninsular Malaysia + N. Sumatra (MET Malaysia) (<1 MB/frame)
#   MYEAST       - East Malaysia (Borneo) + Brunei  (MET Malaysia) (<1 MB/frame)
#
# Examples:
#   LIBREWXR_ENABLED_REGIONS=CONUS,EUROPE   (continental US + Europe)
#   LIBREWXR_ENABLED_REGIONS=US             (all US regions)
#   LIBREWXR_ENABLED_REGIONS=ALL            (everything)
LIBREWXR_ENABLED_REGIONS=ALL

# Global radar-layer toggle.  When true (default), the regional radar
# fetchers below run as normal.  When false, every MRMS / IEM / MSC /
# OPERA / DPC / MARN / CWA / JMA HRPN / MMD / RRQPE provider is skipped
# at startup, no S3 / HTTP fetches happen, and the radar tile path
# returns no data.  The satellite layer continues working unchanged —
# useful for satellite-only deployments and for faster startup during
# development of non-radar features.
LIBREWXR_RADAR_ENABLED=true

# Master switch for the regional NWP chain — HRRR / HRRR-Alaska / HRDPS
# / AROME-OM family / DMI DINI / ICON-EU / WRF-SMN / JMA MSM.  When false, the NWP
# chain collapses to ECMWF IFS only, keeping global model coverage
# intact.  The observed global layer (RRQPE, section 4) is a radar
# region and independent of this toggle — it keeps rendering the
# 60S-70N band either way.  Useful for satellite-only or nowcast-only
# development where the regional download volume isn't worth waiting
# on.  Per-source toggles below still apply when this is true.
LIBREWXR_REGIONAL_NWP_ENABLED=true

# US-side radar data source (USCOMP / AKCOMP / HICOMP / PRCOMP / GUCOMP).
# Canada-side is controlled independently by LIBREWXR_CA_SOURCE.
#   mrms_fallback  - (default) MRMS primary + IEM fallback on failure.
#                    Best coverage, slightly more bandwidth.
#   mrms           - MRMS only, no fallback.  Gaps fall through to the
#                    global observed RRQPE layer first, then IFS.
#                    Least bandwidth.
#   iem            - Legacy IEM N0Q.  NEXRAD-only.
LIBREWXR_NA_SOURCE=mrms_fallback

# Canada-side radar data source (CACOMP) — fully independent of
# LIBREWXR_NA_SOURCE.  Mix any US choice with any Canada choice.
#   mrms_with_msc_blend - (default) MRMS primary covering southern Canada,
#                         MSC Canada blended in to fill gaps north of
#                         MRMS's bbox, MSC fallback if MRMS fails.
#                         Best coverage.
#   mrms                - MRMS only via the CONUS product.  Southern
#                         Canada covered; northern Canada (outside MRMS
#                         bbox) falls through to the global observed
#                         RRQPE layer first, then IFS.  No MSC fetched.
#   msc                 - MSC Canada standalone (native ECCC composite
#                         covering all of Canada).  No MRMS contribution
#                         to CACOMP.
LIBREWXR_CA_SOURCE=mrms_with_msc_blend

# DPC Italy national radar composite (ITCOMP region in the EUROPE
# group).  When true (default), LibreWXR fetches the DPC VMI composite
# every 5 min from the open Radar-DPC v2 REST API.  When false, OPERA
# alone covers the EUROPE group — note that OPERA-over-Italy is
# edge-of-range data from neighbouring countries, since Italy is not
# in the EUMETNET OPERA station list.  Disable only if your deployment
# specifically does not want a CC-BY-SA-licensed data source in the
# stack (every other radar source in LibreWXR is permissive-licensed).
LIBREWXR_DPC_ENABLED=true

# How often (in seconds) to fetch new radar frames.  600 s (10 min) is
# the default cadence, matching Rain Viewer.  Frame timestamps are
# always aligned to clock boundaries (e.g. :00, :10, :20) regardless of
# when the server starts.  Most upstream sources publish every 2-5 min,
# so 300 is the practical lower bound for higher temporal resolution.
LIBREWXR_FETCH_INTERVAL=600

# Number of radar frames to keep in memory.  At the default 10-min
# cadence: 12 frames = 2 hours, 18 = 3 hours, 24 = 4 hours.  More
# frames = longer animation history at the cost of more RAM
# (~96 MB/frame with all regions enabled).
LIBREWXR_MAX_FRAMES=12


# ════════════════════════════════════════════════════════════════════════
#   3. REGIONAL NWP MODELS
# ════════════════════════════════════════════════════════════════════════
# LibreWXR composes its model layer from a chain of regional NWP
# sources, each covering a region.  The chain is built specificity-
# first: a regional high-res model fills its own domain, then a wider
# regional model fills its remainder, then ECMWF IFS catches the rest.
# For PAST frames within the 60S-70N band, though, the observed
# always-on radar region RRQPE (section 4) catches what's left of the
# radar tier first; IFS only fills poleward of the band, in the fringe
# excluded by RRQPE's coverage polygon, and when RRQPE declines.  Soft
# feathering at each domain edge prevents visible seams.
#
# Each toggle below adds one model to the chain.  See section 4 for the
# global model layer (IFS) and the observed band layer (RRQPE).

# ─── North America: NOAA HRRR ────────────────────────────────────────
# Bundles HRRR-CONUS + HRRR-Alaska under a single toggle (same model,
# disjoint domains, same anonymous AWS Open Data bucket).
#   "ifs"  - (default) IFS only; no regional NWP over CONUS or Alaska.
#   "hrrr" - NOAA HRRR — bundles both domains:
#            * HRRR-CONUS  (3 km LCC, 15-min subh, hourly cycles)
#            * HRRR-Alaska (3 km polar stereo, hourly wrfsfcf,
#                           3-hourly cycles)
#            Adds ~280 MB RAM.
LIBREWXR_NA_NWP_SOURCE=hrrr

# ─── Canada: ECCC HRDPS-Continental ───────────────────────────────────
# 2.5 km rotated lat/lon.  Anonymous HTTPS via dd.weather.gc.ca.
# 4 cycles/day, 48 h horizon, hourly steps.  Covers Canada + the
# northern fringe of CONUS.  Adds ~150 MB RAM.
LIBREWXR_HRDPS_ENABLED=true

# ─── Europe: DMI DINI + DWD ICON-EU ──────────────────────────────────
# Each profile names the full set of European sources to instantiate;
# the resulting chain is logged at startup as "NWP chain: [...]" and
# surfaced at /health.
#   "ifs"               - (default) IFS only; no regional NWP over
#                         Europe.
#   "icon_eu_only"      - DWD ICON-EU (~7 km, hourly steps, 3-hourly
#                         cycles) ahead of IFS.  Free DWD opendata —
#                         no auth.
#   "dini_with_icon_eu" - DMI HARMONIE-AROME DINI (2 km native LCC,
#                         hourly steps, 3-hourly cycles) ahead of
#                         ICON-EU ahead of IFS.  Anonymous AWS Open
#                         Data S3.  DINI covers most of populated
#                         Europe at 2 km; ICON-EU stays in the chain
#                         to fill Iberia, S. Italy, Greece, the
#                         Balkans, and eastern Europe past Poland.
#                         Adds ~250 MB RAM total.
LIBREWXR_EU_NWP_PROFILE=dini_with_icon_eu

# ─── Caribbean: Météo-France AROME Antilles ──────────────────────────
# 1.3 km native.  Anonymous HTTPS on the OVH Swift bucket (Météo-France
# migrated PNT distribution off object.data.gouv.fr around 2026-01).
# 4 cycles/day, 48 h horizon, hourly steps.  Tiny in-memory cost
# (~10 MB) — the domain is small.
LIBREWXR_AROME_ANTILLES_ENABLED=true

# ─── Météo-France AROME Outre-Mer (the rest of the family) ──────────
# Same upstream + format + decoder as Antilles via the shared AROME
# overseas base class.  Each covers a different French overseas
# territory; all four are independently toggleable.
#
# GUYANE — French Guiana (~1100×880 km).  Pairs with the Caribbean
# AROME Antilles to give continuous coverage across the Lesser
# Antilles → Guianas arc.
LIBREWXR_AROME_GUYANE_ENABLED=true
# INDIEN — Réunion + Mayotte + Comoros + most of Madagascar + adjacent
# SW Indian Ocean (~3700×2500 km — the largest AROME-OM grid, ~70 MB
# RAM).
LIBREWXR_AROME_INDIEN_ENABLED=true
# NCALED — Nouvelle-Calédonie + adjacent SW Pacific (~1350×1350 km).
LIBREWXR_AROME_NCALED_ENABLED=true
# POLYN — French Polynesia (Society, Tuamotu, Marquesas archipelagoes,
# ~1350×1400 km).
LIBREWXR_AROME_POLYN_ENABLED=true

# ─── South American Cone: SMN Argentina WRF-DET ──────────────────────
# 4 km LCC — covers Argentina, Chile, Uruguay, Paraguay, Bolivia,
# southern Brazil + adjacent oceans.  Anonymous AWS Open Data S3.
# 4 cycles/day, 72 h horizon, NetCDF4 files (~34 MB each).  Adds
# ~30-50 MB RAM.
LIBREWXR_WRF_SMN_ENABLED=true

# ─── East Asia: JMA MSM (Mesoscale Model) ────────────────────────────
# 5 km native (0.0625° lon × 0.05° lat) over 22.4-47.6°N × 120-150°E
# — Japan + Korean Peninsula + Taiwan + Yellow Sea + adjacent waters.
# 8 cycles/day (00/03/06/09/12/15/18/21 UTC), hourly steps, 78 h
# horizon from 00Z/12Z (39 h from others — we only fetch a ~3-hour
# window around now in either case).  Distributed via Open-Meteo's
# anonymous AWS Open Data mirror (same ``openmeteo`` bucket as IFS);
# JMA's direct JMBSC feed is paid-contract-only.  Pairs with the JMA
# HRPN radar (JPCOMP analysis leg) to replace global IFS as the
# regional model layer over Japan.  Adds ~50 MB RAM.
LIBREWXR_JMA_MSM_ENABLED=true

# ─── Optical-flow temporal interpolation ────────────────────────────
# Same Farneback dense-flow technique we use on ECMWF IFS hourly
# frames, applied to every regional NWP source whose native cadence
# is hourly (WRF-SMN, DMI DINI, ICON-EU, JMA MSM — others as they're
# added).
# Without this, a moving precip cell appears to cross-fade between
# hourly bracket frames at intermediate query times, producing a
# visible "two faint copies" ghost.  With it, the cell translates
# smoothly along motion vectors.  Adds ~2-10 s of CPU per source
# per fetch cycle (smallest grid ~2 s, largest ~10 s).  Snow masks
# ride alongside precip through the same interpolation step.
LIBREWXR_REGIONAL_INTERPOLATION=true

# ─── Native snow/rain classification threshold ──────────────────────
# Temperature cutoff for the regional NWP snow masks (HRRR-CONUS,
# HRRR-Alaska, WRF-SMN, DMI DINI, ICON-EU, JMA MSM all derive a snow
# mask from their own 2-metre temperature field; HRDPS and AROME
# Antilles fall through to ECMWF IFS for snow detection).  Pixels colder than
# this are tagged as snow.  1.5 °C is a typical near-surface snow-vs-
# rain transition; drop towards 0 °C for a stricter "only true
# freezing" definition; raise to 2-3 °C to catch wet snow / sleet
# that visually behaves like snow on the ground.
LIBREWXR_REGIONAL_SNOW_TEMP_THRESHOLD=1.5

# ─── Fetch concurrency ───────────────────────────────────────────────
# Maximum number of NWP grid fetches running in parallel inside one
# fetch cycle.  Each grid loads tens-to-hundreds of MB during decode,
# so this caps peak transient RAM at ~N × per-grid working set.
# 4 fits comfortably in 8 GB; bump to 6-8 on bigger rigs to bring
# cycle wall time closer to the slowest single source.  In multi
# mode the pipeline sidecar has its own memory budget, so it can
# usually go higher than in single mode.
LIBREWXR_NWP_FETCH_CONCURRENCY=4


# ════════════════════════════════════════════════════════════════════════
#   4. ECMWF IFS + NOAA RRQPE — GLOBAL BASE LAYERS
# ════════════════════════════════════════════════════════════════════════
# RRQPE (NOAA Enterprise Rain Rate GLB-5) is the always-on coarse global
# OBSERVED radar region — a 60S-70N band at the bottom compositing tier
# that fills past/current frames wherever no finer radar region claims
# the pixel, and it joins radar nowcast extrapolation like any region.
# IFS is the terminal MODEL of the NWP chain: for past frames it fills
# only poleward of the RRQPE band, in the 2-degree fringe excluded by
# RRQPE's coverage polygon, and when RRQPE declines (missed scans /
# stale store); it also drives the nowcast blend tail.

# Disable ECMWF IFS entirely.  Useful only for isolating regional NWP
# layers during debugging — the always-on RRQPE observed region keeps
# rendering the 60S-70N band, so only pixels poleward of the band or
# in the excluded fringe will then simply show zero precipitation.
LIBREWXR_ECMWF_ENABLED=true

# Enable optical-flow interpolation of ECMWF IFS hourly data to 10-min
# frames.  Adds ~130 MB RAM and ~5-10 s compute per IFS fetch.  Disable
# for jumpier hour-to-hour animation but lower CPU/RAM cost.
LIBREWXR_ECMWF_INTERPOLATION=true

# Number of ECMWF IFS hourly timesteps to fetch.  0 = auto
# (recommended): derived from LIBREWXR_MAX_FRAMES + nowcast window so
# the IFS animation covers the same time span as radar.  Set
# explicitly to override.
LIBREWXR_ECMWF_MAX_TIMESTEPS=0

# ─── NOAA RRQPE — global observed precipitation ──────────────────────
# NOAA Enterprise Rain Rate (RRQPE) GLB-5 blend — satellite-derived
# OBSERVED precipitation (IR-based estimate, 0.02° grid) from NOAA's
# anonymous open-data bucket, 10-min cadence, ~17-min publish latency,
# 60S-70N.  Ingested as a single coarse global RADAR region — the
# always-on bottom compositing tier that fills only pixels no finer
# radar region claims, beneath every regional composite — and it joins
# radar nowcast extrapolation like any other region.  NOAA NODD open
# data; attribution requested ("Precipitation data from NOAA Enterprise
# Rain Rate (RRQPE)").  ~350 MB in the FrameStore for the default
# 2-hour window (12 × ~29 MB past frames), plus ~175 MB of
# nowcast-extrapolated frames.
LIBREWXR_RRQPE_ENABLED=true


# ════════════════════════════════════════════════════════════════════════
#   5. PRECIPITATION NOWCASTING
# ════════════════════════════════════════════════════════════════════════
# Short-range precipitation forecast (EXPERIMENTAL).  Extrapolates
# recent radar forward using optical flow, optionally blended with the
# active NWP model from the chain — HRRR over CONUS, HRDPS over
# Canada, ICON-EU/DINI over Europe, AROME Antilles over the Caribbean,
# WRF-SMN over the S. American Cone, IFS everywhere else.

# Enable nowcasting.  Quality varies: works best for steady, organized
# precipitation; less reliable for fast-developing convection or cell
# initiation / dissipation.
LIBREWXR_NOWCAST_ENABLED=true

# Nowcast blend mode for the first 60 min of the nowcast window.
# Beyond 60 min, pure model is always used.
#   "radar"   - pure radar extrapolation (closest to Rain Viewer
#               behaviour; visibly diverges from reality past ~30 min
#               for fast-moving convection)
#   "blended" - (default) smooth radar → model transition (~82% radar
#               at T+10, fading to ~20% radar at T+60).  Leverages the
#               regional NWP chain (HRRR / HRDPS / DMI DINI / ICON-EU
#               / AROME / WRF-SMN / IFS) for the far end of the window
#   "model"   - pure NWP forecast (most spatially consistent, misses
#               fine detail from recent radar)
LIBREWXR_NOWCAST_BLEND_MODE=blended

# Number of nowcast frames to generate.  At 10-min cadence, 6 frames
# = 60 min forecast.  More frames = longer range, lower far-end
# accuracy.
LIBREWXR_NOWCAST_FRAMES=6

# Progressive spatial coarsening of the extrapolated radar with lead
# time: each forecast frame is Gaussian-smoothed with a sigma that
# ramps quadratically, so by T+60 the effective resolution has
# coarsened from native (~1 km) to ~3 km.  Low-passes the high-
# frequency melt/filament artifacts of long optical-flow extrapolation
# and encodes growing positional uncertainty.  External contribution
# frames are never smoothed.
LIBREWXR_NOWCAST_COARSEN_ENABLED=true

# Effective resolution floor reached at the last blend step (km);
# sigma = max_km * (step / blend_steps)^2.  0 disables the smoothing.
LIBREWXR_NOWCAST_COARSEN_MAX_KM=3.0

# ─── Motion-arrow overlay ────────────────────────────────────────────
# The /v2/radar tile endpoint supports a ?arrows= query param that
# overlays precipitation motion-direction arrows on areas of active
# precip.  Arrow direction comes from optical flow computed between
# the two most recent radar frames (per region, fine-grained) plus a
# single composite NWP flow raster outside radar coverage (reflecting
# whichever regional NWP model is active — HRRR over CONUS, ICON-EU
# over Europe, JMA MSM over Japan, IFS elsewhere — rather than IFS
# alone).
#
# This toggle decouples the arrow optical-flow computation from
# `LIBREWXR_NOWCAST_ENABLED`: arrows "just work" regardless of the
# nowcast state.  An operator who wants zero flow CPU sets BOTH
# `nowcast_enabled=false` AND `arrow_flow_enabled=false` — the arrow
# overlay is then suppressed entirely (the ?arrows= query becomes a
# no-op).
LIBREWXR_ARROW_FLOW_ENABLED=true

# ─── Storm-cell detection overlay ────────────────────────────────────
# The /v2/radar tile endpoint supports a ?cells=light|dark query param
# that overlays detected storm-cell centroids + motion vectors on the
# tile.  Runs each fetch cycle; detected cells + motion vectors are
# stored for the renderer to overlay on radar tiles.
LIBREWXR_STORM_CELLS_ENABLED=true
# Minimum dBZ for a pixel to be part of a detected cell (default 40 = moderate convection)
LIBREWXR_STORM_CELLS_MIN_DBZ=40
# Minimum cell area in km^2 — filters out noise/small cells (default 25 km^2)
LIBREWXR_STORM_CELLS_MIN_AREA_KM2=25.0


# ════════════════════════════════════════════════════════════════════════
#   6. SATELLITE IMAGERY
# ════════════════════════════════════════════════════════════════════════
# Real satellite imagery backed by NOAA's GMGSI hourly global mosaic
# (GOES-East + GOES-West + Meteosat-9 + Meteosat-10 + Himawari-9,
# composited and re-projected by NESDIS).  Two channels are ingested:
# longwave IR for the 24/7 base, visible for the daytime overlay.  The
# /v2/satellite/... tile endpoint serves a VIS-over-LW composite with
# a natural day/night terminator crossfade.

# Master switch for the satellite layer.  When false (default true),
# the satellite endpoint returns 503 and the catalog's
# satellite.infrared array is empty (same pattern as
# LIBREWXR_RADAR_ENABLED).
LIBREWXR_SATELLITE_ENABLED=true

# Per-channel GMGSI toggles.  LW backs the IR night side; VIS adds
# the daytime reflected-sunlight overlay with a natural sunrise/sunset
# crossfade at the terminator.  Disabling VIS while LW stays on
# degrades the composite to LW-only without breaking the endpoint.
LIBREWXR_GMGSI_LW_ENABLED=true
LIBREWXR_GMGSI_VIS_ENABLED=true

# Number of hourly satellite frames retained per channel.  GMGSI
# publishes one frame per hour, so 12 ≈ 12 hours of animation.  Each
# frame is ~15 MB, so 12 frames × 2 channels ≈ 360 MB resident.
LIBREWXR_SATELLITE_MAX_FRAMES=12


# ════════════════════════════════════════════════════════════════════════
#   7. WEATHER ALERTS (WMO CAP)
# ════════════════════════════════════════════════════════════════════════
# Global weather alerts polled from severeweather.wmo.int, plus the
# NWS point endpoint for US locations (surfaces non-polygon alerts
# like Tornado Watches).  MeteoAlarm geocodes are downloaded on first
# startup and cached locally.  Updates are clock-aligned
# (:00, :05, :10, …).

# Enable the alerts API.  When off, /v2/alerts returns 503.
LIBREWXR_ALERTS_ENABLED=true

# How often (in seconds) to refresh alerts.  300 s (5 min) matches the
# upstream update cadence; 600 s halves the request volume.
LIBREWXR_ALERTS_FETCH_INTERVAL=300

# Max concurrent HTTP connections when polling the WMO endpoints.
LIBREWXR_ALERTS_CONCURRENCY=5


# ════════════════════════════════════════════════════════════════════════
#   8. TILE RENDERING
# ════════════════════════════════════════════════════════════════════════
# How rendered radar tiles look, how big the caches are, and how much
# is pre-rendered after each fetch cycle.  All cache sizes are
# per-worker (the shared coordinate store below is the exception - one
# on-disk copy for the whole deployment).

# ─── Cache sizes ─────────────────────────────────────────────────────
# Defaults track LIBREWXR_MODE — see section 9 to override.

# ─── Shared coordinate store ─────────────────────────────────────────
# Projection-coordinate arrays shared by all render workers as read-only
# memmaps via the persistent disk cache (section 10) - each unique
# tile's coordinate grids are computed once globally instead of once per
# worker.  Enabled by default; false reverts to per-worker in-process
# caches (also the automatic fallback when LIBREWXR_CACHE_DIR is
# unset).  Size cap: LIBREWXR_COORD_STORE_MB in section 9.
LIBREWXR_COORD_STORE_ENABLED=true

# ─── Image filters ───────────────────────────────────────────────────

# Baseline Gaussian blur radius for tile smoothing (when smooth=1 in
# the tile URL).  The renderer auto-scales this up at high zoom for
# coarse sources (OPERA, MRMS, MMD, etc.) by inspecting how many tile
# pixels each region pixel covers — so this value sets the floor, not
# the cap.  0 = disable smoothing entirely.
LIBREWXR_SMOOTH_RADIUS=1.0

# Minimum dBZ threshold to display.  Pixels below this are made
# transparent.  Filters out ground clutter and weak noise.  Set to
# -32 to show everything.
LIBREWXR_NOISE_FLOOR_DBZ=10.0

# Speckle filter: minimum non-zero neighbors (out of 8) a pixel must
# have to be kept.  0 = disabled, 3 = moderate (recommended),
# 4+ = aggressive.
LIBREWXR_DESPECKLE_MIN_NEIGHBORS=3

# WebP encoding quality.  100 = lossless (default); 1-99 = lossy
# option for bandwidth-constrained deployments.  Only affects
# WebP-format tiles.
LIBREWXR_WEBP_QUALITY=100

# ─── Pre-warming ─────────────────────────────────────────────────────

# Pre-warm coordinate caches up to this zoom level at startup, as a
# background task - the server starts serving immediately and the warm
# proceeds alongside (never blocks boot).
# 0 (or unset) = per-mode default: single warms to zoom 6, multi render
# workers do no eager warm (entries load lazily through the shared store).
# Negative = disabled entirely in either mode; positive = force that zoom.
LIBREWXR_WARM_COORD_ZOOM=0

# Pre-render overview tiles up to this zoom level after each fetch
# cycle.  -1 = disabled.  At zoom 4, ~341 tiles per timestamp.
# Single mode only — no-op in multi mode (the empty-tile fast path + per-worker LRU cover it).
LIBREWXR_WARM_OVERVIEW_ZOOM=4

# Pre-render higher-zoom tiles ONLY where they overlap an enabled
# region's bounding box.  Skips ocean / desert / unpopulated tiles.
# Applies between LIBREWXR_WARM_OVERVIEW_ZOOM (exclusive) and this
# value (inclusive).  -1 (or <= warm_overview_zoom) disables the
# regional pass.
# Single mode only — no-op in multi mode (the empty-tile fast path + per-worker LRU cover it).
LIBREWXR_WARM_OVERVIEW_ZOOM_REGIONAL=6


# ════════════════════════════════════════════════════════════════════════
#   9. MODE TUNING OVERRIDES
# ════════════════════════════════════════════════════════════════════════
# Every setting in this section has a different sensible default
# depending on COMPOSE_PROFILES / LIBREWXR_MODE (set in section 0).
# The app fills in the right value automatically; uncomment any line
# below to override.
#
# Per-worker values are PER WORKER in multi mode — total RAM scales
# with the worker count.
#
#                            single default      multi default
# ────────────────────────────────────────────────────────────────────
# LIBREWXR_WORKERS           1                   16
# LIBREWXR_TILE_CACHE_MB     200 (total)         128  (per worker)
# LIBREWXR_COORD_CACHE_SIZE  2048 (total)        512  (per worker)
# LIBREWXR_COORD_STORE_MB    1024 (shared on-disk)    8192 (shared on-disk; one store for ALL render workers)
# LIBREWXR_WARMER_THREADS    0 (auto: CPU-1)     4    (per worker; sizes the request-executor pool in multi — warming is single-mode only)
# LIBREWXR_COORD_STORE_MB is a DISK budget (not RAM), not per-worker - soft-capped and pruned oldest-first down to 90% once per fetch cycle; applies only when LIBREWXR_CACHE_DIR (section 10) is set.
#
# Worker count guidance:
#   single - 1 worker per 2 CPU cores; each is a full LibreWXR copy
#            with its own frame store + fetcher (~1.3 GB+ RAM each).
#            Put a caching proxy (nginx, Cloudflare) in front for
#            high traffic.
#   multi  - 8-32 renderer workers depending on rack size; the
#            pipeline sidecar fetches once, all renderers share via
#            memmap.  Total RSS on an 80-core / 32 GB rack with 32
#            workers settles around ~16 GB across both containers.

#LIBREWXR_WORKERS=
#LIBREWXR_TILE_CACHE_MB=
#LIBREWXR_COORD_CACHE_SIZE=
#LIBREWXR_COORD_STORE_MB=
#LIBREWXR_WARMER_THREADS=

# ─── Container memory caps ──────────────────────────────────────────
# Docker enforces these via deploy.resources.limits in the compose
# file.  Mode-dependent: single uses LIBREWXR_MEMORY; multi uses the
# two separate caps for the pipeline and renderer containers.
#
#                              default
# ────────────────────────────────────────────────────────────────────
# LIBREWXR_MEMORY              7G     (single only)
# LIBREWXR_PIPELINE_MEMORY     12G    (multi only)
# LIBREWXR_RENDER_MEMORY       18G    (multi only)

#LIBREWXR_MEMORY=7G
#LIBREWXR_PIPELINE_MEMORY=12G
#LIBREWXR_RENDER_MEMORY=18G

# In-process memory pressure monitor cap (MB).  Independent of the
# container limits above — this is what triggers internal cache
# evictions before hitting the OOM killer.  0 = auto-detect from
# cgroup, falling back to system RAM.
LIBREWXR_MEMORY_LIMIT_MB=0


# ════════════════════════════════════════════════════════════════════════
#   10. PERSISTENT DISK CACHE
# ════════════════════════════════════════════════════════════════════════
# Where processed grids (NWP, satellite, alerts geocodes, master state
# snapshot) live on disk so they survive restarts.  Required in multi
# mode — the pipeline writes the shared snapshot here and renderers
# memmap it.

# Cache directory for processed grids.  When set, data is saved as
# memory-mapped files that survive restarts, crashes, and container
# recreation.  Empty = in-memory only (everything re-downloaded on
# startup).
#
# REQUIRED in multi mode (both the pipeline and renderer containers
# must share this directory via a named volume — the compose file
# sets this automatically).
#
# Docker: set automatically via a named volume (see docker-compose.yml).
# Local dev: set to a local path like ./cache.
LIBREWXR_CACHE_DIR=


# ════════════════════════════════════════════════════════════════════════
#   11. DIAGNOSTICS & RELIABILITY
# ════════════════════════════════════════════════════════════════════════
# Observability hooks and resilience tuning.  None of this changes
# the data you serve — just how you can see into the running server
# and how it handles transient upstream failures.

# Per-tile request counts at high zooms are recorded in memory and
# surfaced in /health under `tile_requests`.  Useful for spotting
# traffic hotspots; cheap on the hot path; counters reset on
# restart.
LIBREWXR_TILE_TRACKING_ENABLED=true

# Number of retries on transient download errors (connection refused,
# timeout, DNS failure, truncated response).  0 = fail immediately,
# 1 = one retry.  Applies to every data source (radar, NWP,
# satellite, alerts).  Each retry waits 1 second before trying
# again.
LIBREWXR_DOWNLOAD_RETRIES=1


# ════════════════════════════════════════════════════════════════════════
#   12. MCP SERVER (MODEL CONTEXT PROTOCOL)
# ════════════════════════════════════════════════════════════════════════
# LibreWXR ships a built-in MCP (Model Context Protocol) server with two
# transports.  The HTTP transport is mounted inside the main FastAPI app
# at LIBREWXR_MCP_PATH.  The stdio transport runs as a standalone process
# (python -m librewxr.mcp / librewxr-mcp) and reads state.json from
# LIBREWXR_CACHE_DIR.  Both require the optional [mcp] extra:
#   pip install -e ".[mcp]"
# Without it, the HTTP transport is silently disabled at startup with a
# logged warning; the stdio entry point won't import.

# Master switch for the MCP HTTP transport.  When false, no /mcp route
# is mounted and the MCP lifespan is not combined (the app boots lean).
# The standalone stdio entry (python -m librewxr.mcp / librewxr-mcp) is
# unaffected by this flag — it runs independently.
LIBREWXR_MCP_ENABLED=true

# URL path where the MCP HTTP transport is mounted inside the FastAPI
# app.  Change if you need a different endpoint path (e.g. /api/mcp).
LIBREWXR_MCP_PATH=/mcp
